<%- include('Partials/header.ejs') %>

<body>
<%- include('Partials/main_nav.ejs') %>

<div class="page-wrapper">
    <section class="section">
        <div class="container">
            <p class="section-label">Who I Am</p>
            <h1 class="section-title">About Me</h1>
            <div class="divider"></div>

            <div class="row g-5 align-items-start">
                <!-- LEFT — profile + video -->
                <div class="col-lg-5 reveal">
                    <img src="/Assets/images/Profile.png" alt="Daniel Borrell Diaz" class="about-profile-img">

                    <div class="about-video-wrap mt-4">
                        <video width="100%" controls poster="/Assets/images/sky.png" preload="auto" autoplay loop muted id="myVid">
                            <source src="/Assets/images/sky.mp4" type="video/mp4">
                        </video>
                    </div>
                    <button class="play-btn" onclick="PlayPause()">
                        <i class="fa-solid fa-play fa-xs"></i> Toggle Play / Pause
                    </button>
                </div>

                <!-- RIGHT — bio + stats + skills -->
                <div class="col-lg-7 reveal">
                    <p style="font-family:var(--font-mono); font-size:0.85rem; line-height:1.85; color:var(--text-muted); margin-bottom:1.5rem;">
                        My name is Daniel. I'm astudent at Ontario Tech University enrolled in the 
                        <strong style="color:var(--text);">Networking &amp; IT Security</strong> program. 
                         Proficient in networking systems and cybersecurity tactics, with a solid foundation in IT troubleshooting practices. 
                         Additionally, I hold a Cisco CCNA: Introduction to Networks certification, 
                         which demonstrates a strong understanding of networking fundamentals.
                    </p>
                    <p style="font-family:var(--font-mono); font-size:0.85rem; line-height:1.85; color:var(--text-muted); margin-bottom:2rem;">
                        I'm passionate about applied IT networking, network defense, and building software that 
                        solves real problems. Check out my LinkedIn for a full overview of my skills and experience.
                    </p>

                    <div class="divider"></div>

                    <p class="section-label s2" style="margin-bottom:0.8rem;">Tech Stack &amp; Skills</p>
                    <div class="skill-list">
                        <span class="skill-pill">IT Support & Ticketing</span>
                        <span class="skill-pill">Networking & Routing</span>
                        <span class="skill-pill">Network Diagnostics</span>
                        <span class="skill-pill">Cloud Computing</span>
                        <span class="skill-pill">Systems Administration</span>
                        <span class="skill-pill">Virtualization</span>
                        <span class="skill-pill">Programming & Scripting</span>
                        <span class="skill-pill">Client Communication</span>
                        <span class="skill-pill">Git/GitHub</span>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <a href="https://www.linkedin.com/in/daniel-borrell-diaz-0455b62ba" target="_blank" class="btn-primary-custom">
                            <i class="fa-brands fa-linkedin fa-sm"></i> LinkedIn
                        </a>
                        <a href="https://github.com/danielabd-it" target="_blank" class="btn-ghost-custom">
                            <i class="fa-brands fa-github fa-sm"></i> GitHub
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('Partials/footer.ejs') %>
</body>
