<%- include('Partials/header.ejs') %>

<body>
<%- include('Partials/main_nav.ejs') %>

<div class="page-wrapper">
    <section class="section">
        <div class="container">
            <p class="section-label s2">My Work</p>
            <h1 class="section-title">Projects</h1>
            <p class="section-subtitle">
                A selection of academic and personal projects built during my time at Ontario Tech University.
            </p>
            <div class="divider"></div>

            <!-- Project 1 -->
            <div class="row g-0 align-items-stretch project-card reveal">
                <div class="col-md-5">
                    <img src="/Assets/images/bmi.png" alt="BMI Python GUI Project" class="project-card-img" style="height:100%;">
                </div>
                <div class="col-md-7 project-card-body d-flex flex-column justify-content-center">
                    <span class="project-tag">Python &bull; GUI &bull; Health</span>
                    <h2>BMI Calculator — Python GUI</h2>
                    <p>
                        A desktop application built in Python that calculates Body Mass Index from user-supplied 
                        height and weight inputs via a graphical interface. The program categorizes the result 
                        as underweight, healthy, or overweight and displays the BMI score in real time.
                        This was my first experience building a GUI-driven application.
                    </p>
                    <div class="mt-3">
                        <a href="https://github.com/danielabd-it" target="_blank" class="btn-ghost-custom" style="font-size:0.8rem; padding:0.5rem 1rem;">
                            <i class="fa-brands fa-github fa-xs"></i> View on GitHub
                        </a>
                    </div>
                </div>
            </div>

            <!-- Project 2 -->
            <div class="row g-0 align-items-stretch project-card reveal" style="flex-direction:row-reverse;">
                <div class="col-md-5">
                    <img src="/Assets/images/encrypt.png" alt="Encryption Project" class="project-card-img" style="height:100%;">
                </div>
                <div class="col-md-7 project-card-body d-flex flex-column justify-content-center">
                    <span class="project-tag">Python &bull; Cryptography &bull; Security</span>
                    <h2>Multi-Cipher Encryption Engine</h2>
                    <p>
                        A Python program that accepts continuous text input until the user types "stop." 
                        Each entry is collected into arrays and lists, then randomly encrypted using one of 
                        six classical and modern algorithms: Substitution, Playfair, Caesar, Transposition, 
                        Product cipher, and RSA. A deep dive into applied cryptography fundamentals.
                    </p>
                    <div class="mt-3">
                        <a href="https://github.com/ScareCrowvv" target="_blank" class="btn-ghost-custom" style="font-size:0.8rem; padding:0.5rem 1rem;">
                            <i class="fa-brands fa-github fa-xs"></i> View on GitHub
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>

<%- include('Partials/footer.ejs') %>
</body>
