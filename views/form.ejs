<%- include('Partials/header.ejs') %>

<body>
<%- include('Partials/main_nav.ejs') %>

<div class="page-wrapper">
    <section class="section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7 text-center mb-5 reveal">
                    <p class="section-label s3" style="justify-content:center;">Get In Touch</p>
                    <h1 class="section-title">Contact Me</h1>
                    <p class="section-subtitle" style="margin:0 auto;">
                        Have a question, opportunity, or just want to connect? Fill out the form below 
                        and I'll get back to you.
                    </p>
                </div>
            </div>

            <div class="reveal">
                <form class="form-wrap"
                      action="mailto:daniel.borrelldiaz@ontariotechu.net"
                      method="post"
                      enctype="text/plain">

                    <div class="mb-4">
                        <label for="name" class="form-label">Name</label>
                        <input class="form-control" type="text" id="name" name="name"
                               placeholder="Your full name" required>
                    </div>

                    <div class="mb-4">
                        <label for="email" class="form-label">Email</label>
                        <input class="form-control" type="email" id="email" name="email"
                               placeholder="your@email.com" required>
                    </div>

                    <div class="mb-4">
                        <label for="comments" class="form-label">Message</label>
                        <textarea class="form-control" id="comments" name="comment"
                                  placeholder="Write your message here..." required></textarea>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label for="rate" class="form-label">Rate This Site (out of 5)</label>
                            <select id="rate" name="rate" class="form-select" required>
                                <option value="" disabled selected>Select a rating</option>
                                <option value="1">1 — Needs work</option>
                                <option value="2">2 — Below average</option>
                                <option value="3">3 — Average</option>
                                <option value="4">4 — Good</option>
                                <option value="5">5 — Excellent</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label for="major" class="form-label">Your Major</label>
                            <select id="major" name="major" class="form-select" required>
                                <option value="" disabled selected>Select your major</option>
                                <option value="Computer Science">Computer Science</option>
                                <option value="Software Engineer">Software Engineering</option>
                                <option value="IT">Information Technology</option>
                                <option value="Cyber Security">Cybersecurity</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="consent" name="consent" required>
                        <label class="form-check-label" for="consent">
                            I consent to my answers potentially being shared publicly.
                        </label>
                    </div>

                    <div class="d-flex justify-content-between gap-3">
                        <input class="btn-reset-custom" type="reset" value="Reset Form">
                        <input class="btn-submit" type="submit" value="Send Message →">
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

<%- include('Partials/footer.ejs') %>
</body>
